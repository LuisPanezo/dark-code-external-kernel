{
  "name": "darkcode-login-auth",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "vars": { "SAO_APP_NAME": "Dark Code Kernel", "SAO_VERSION": "1.0" },
  "durable_objects": { "bindings": [{ "name": "AUTH_STATE", "class_name": "AuthState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AuthState"] }],
  "observability": { "enabled": false }
}
